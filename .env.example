# Copy to .env and pick ONE option.

# --- Option A: Gemini API key from Google AI Studio (quickest) ---
# Get a key at https://aistudio.google.com/apikey. No Google Cloud project needed.
# Memory is in-process only; Memory Bank and the manager dashboard need Option B.
# GEMINI_API_KEY=your-api-key-here

# --- Option B: Google Cloud project (full feature set) ---
# Requires: gcloud auth application-default login
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
